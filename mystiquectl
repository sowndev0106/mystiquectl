#!/usr/bin/env bash
# mystiquectl -- start the app, or look after this install.
#
#   mystiquectl [args]            start the app on your desktop, against the
#                                 real cooler (DC_UI=1 run-real.sh [args]);
#                                 if it's already running, show its window
#   mystiquectl --background      start it hidden, in the tray -- what
#                                 autostart runs at login
#   mystiquectl autostart [on|off|status]
#                                 start --background at every login or not
#   mystiquectl update            pull the latest source, refresh electron,
#                                 deps, launcher and menu entry
#   mystiquectl uninstall [-y]    stop the app, remove the launcher, menu
#                                 entry, icon and autostart, restore the
#                                 pristine app.asar, and delete this checkout
#                                 if install.sh's curl | bash path created it
#                                 (a clone of your own stays)
#   mystiquectl help
#
# ~/.local/bin/mystiquectl, written by install.sh, just execs this file.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BIN_DIR="$HOME/.local/bin"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
LAUNCHER="$BIN_DIR/mystiquectl"
DESKTOP_FILE="$DATA_DIR/applications/mystiquectl.desktop"
ICON_FILE="$DATA_DIR/icons/hicolor/scalable/apps/mystiquectl.svg"
AUTOSTART_FILE="$CONFIG_DIR/autostart/mystiquectl.desktop"
STATE_DIR="$CONFIG_DIR/mystiquectl"
# "on" or "off", whichever was last chosen; install.sh only turns autostart
# on when there is no choice recorded yet.
AUTOSTART_STATE="$STATE_DIR/autostart"
BLOCK_BEGIN="# >>> mystiquectl autostart >>>"
BLOCK_END="# <<< mystiquectl autostart <<<"
# Window managers that run no ~/.config/autostart entries, only what their
# own config starts: name|env var set while it runs|how its config starts a
# program|where it looks for that config, first one found wins. (sway falls
# back to the i3 config when it has none of its own, which works out too.)
WMS=(
  "sway|SWAYSOCK|exec|$CONFIG_DIR/sway/config|$HOME/.sway/config"
  "i3|I3SOCK|exec|$CONFIG_DIR/i3/config|$HOME/.i3/config"
  "hyprland|HYPRLAND_INSTANCE_SIGNATURE|exec-once =|$CONFIG_DIR/hypr/hyprland.conf"
)
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/mystiquectl/launch.log"
ASAR="${DC_ASAR:-$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles/Local/drive_c/DeepCool/resources/app.asar}"

usage() { sed -n '2,18s/^# \{0,1\}//p' "$HERE/mystiquectl"; }

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -i mystiquectl "$1" "$2"
  return 0
}

# The running app's main electron pid, if any -- the same test as
# run-real.sh's app_running() (see there for why it matches words), minus
# the socket.
app_pid() {
  local p args
  for p in $(pgrep -x electron); do
    args=" $(tr '\0' ' ' 2>/dev/null < "/proc/$p/cmdline") " || continue
    case "$args" in *" --type="*) continue ;; esac
    case "$args" in *" $ASAR "*) echo "$p"; return 0 ;; esac
  done
  return 1
}

run() {
  # From a terminal, behave exactly like running run-real.sh by hand.
  if [ -t 2 ]; then
    exec env DC_UI=1 "$HERE/run-real.sh" "$@"
  fi
  # Started from the app menu, by install.sh or at login: nobody sees
  # stderr, so keep it in a log and turn a failed start into a desktop
  # notification.
  # Appended, not truncated: a click that only shows the window of an app
  # already running must not wipe what that app has logged so far.
  mkdir -p "$(dirname "$LOG")"
  [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 1000000 ] && mv -f "$LOG" "$LOG.old"
  local start; start=$(( $(wc -l 2>/dev/null < "$LOG" || echo 0) + 1 ))
  echo "--- $(date '+%F %T') mystiquectl ${DC_BACKGROUND:+--background }$*" >> "$LOG"
  env DC_UI=1 "$HERE/run-real.sh" "$@" >>"$LOG" 2>&1
  local rc=$?
  if [ "$rc" != 0 ]; then
    local msg
    msg="$(tail -n +"$start" "$LOG" | grep -m1 '^error:' || tail -n1 "$LOG")"
    notify "mystiquectl could not start" "${msg#error: }"$'\n'"Full log: $LOG"
  fi
  return "$rc"
}

background() {
  # Typed in a terminal: detach, so the prompt comes back and closing the
  # terminal doesn't take the app with it.
  if [ -t 2 ]; then
    setsid -f "$HERE/mystiquectl" --background "$@" </dev/null >/dev/null 2>&1
    echo "starting in the background (tray icon); log: $LOG"
    return 0
  fi
  # At login the cooler may not have enumerated yet, and run-real.sh gives up
  # at once without it.
  local i wait="${MYSTIQUECTL_WAIT:-30}"
  for ((i = 0; i < wait; i++)); do
    lsusb 2>/dev/null | grep '3633:0009' >/dev/null && break
    sleep 1
  done
  if ! lsusb 2>/dev/null | grep '3633:0009' >/dev/null; then
    notify "mystiquectl did not start" "No MYSTIQUE cooler (3633:0009) found after ${wait}s -- plug it in, then start mystiquectl."
    return 1
  fi
  # Started with -autoRun the tray icon is all there is, and Chromium only
  # uses the StatusNotifier tray if its host (waybar, a KDE/GNOME panel) is up
  # when the icon is made -- otherwise it falls back to a legacy one those
  # never show. At login that host may start after us; give it a moment.
  # Without gdbus, or with no tray host at all (plain GNOME), just go.
  if command -v gdbus >/dev/null 2>&1; then
    for ((i = 0; i < ${MYSTIQUECTL_TRAY_WAIT:-15}; i++)); do
      gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.kde.StatusNotifierWatcher 2>/dev/null | grep -q true && break
      sleep 1
    done
  fi
  DC_BACKGROUND=1 run "$@"
}

# One "name|config|exec line|env var" row per window manager in WMS, with
# the config empty when none of its paths exists.
wm_rows() {
  local spec name var kw rest p cfg
  for spec in "${WMS[@]}"; do
    IFS='|' read -r name var kw rest <<<"$spec"
    cfg=""
    while [ -n "$rest" ]; do
      p="${rest%%|*}"; [ "$p" = "$rest" ] && rest="" || rest="${rest#*|}"
      [ -f "$p" ] && { cfg="$p"; break; }
    done
    printf '%s|%s|%s|%s\n' "$name" "$cfg" "$kw \"$LAUNCHER\" --background" "$var"
  done
}

has_block() { [ -f "$1" ] && grep -qxF "$BLOCK_BEGIN" "$1"; }

# Never creates a config: one in your home replaces the window manager's
# system default wholesale.
wm_add() {
  local name="$1" cfg="$2" line="$3"
  if has_block "$cfg"; then
    echo "autostart on: already in $cfg"
  elif [ -w "$cfg" ]; then
    [ -e "$cfg.mystiquectl.bak" ] || cp -p "$cfg" "$cfg.mystiquectl.bak"
    # On a line of its own even if the file doesn't end in a newline.
    if { [ -z "$(tail -c1 "$cfg")" ] || echo; printf '%s\n%s\n%s\n' "$BLOCK_BEGIN" "$line" "$BLOCK_END"; } >> "$cfg"; then
      echo "autostart on: added to $cfg (backup: $cfg.mystiquectl.bak)"
    else
      echo "warning: couldn't write $cfg -- add this line to it yourself: $line" >&2
    fi
  else
    echo "$cfg isn't writable (managed by something else?) -- add this line to it yourself: $line"
  fi
}

# Only exactly what wm_add added comes out: marker, our exec line, marker,
# one after the other. A marker anywhere else (moved, edited, half-deleted by
# hand) leaves the whole file alone -- cutting "from one marker to the next"
# could take your own lines with it.
wm_remove() {
  local cfg="$1" target tmp
  has_block "$cfg" || return 0
  target="$(readlink -f "$cfg")"
  # Next to the real file, then mv: never a half-written config if the disk
  # fills, and a config symlinked into a dotfiles repo stays a symlink.
  if ! tmp="$(mktemp "$target.XXXXXX" 2>/dev/null)"; then
    echo "warning: can't write next to $target -- remove the mystiquectl lines from it by hand" >&2
  elif awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" '
         { line[NR] = $0 }
         END {
           for (i = 1; i <= NR; i++) {
             if (line[i] == b && line[i + 1] ~ /^(exec|exec-once *=) .*mystiquectl.* --background$/ && line[i + 2] == e) { i += 2; continue }
             if (line[i] == b || line[i] == e) stray = 1
             print line[i]
           }
           exit stray
         }' "$cfg" > "$tmp"; then
    chmod --reference="$target" "$tmp" 2>/dev/null
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    echo "warning: the mystiquectl lines in $cfg aren't the block it added any more -- left the file alone; remove them by hand" >&2
  fi
}

autostart_on() {
  mkdir -p "$STATE_DIR"; echo on > "$AUTOSTART_STATE"
  mkdir -p "$(dirname "$AUTOSTART_FILE")"
  # No NoDisplay: GNOME's and KDE's startup-app settings hide entries that
  # have it, and that's where people look to switch this off.
  cat > "$AUTOSTART_FILE" <<DESKTOP
[Desktop Entry]
Type=Application
Name=mystiquectl
Comment=Start mystiquectl hidden, in the tray
Exec="$LAUNCHER" --background
Icon=mystiquectl
Terminal=false
X-GNOME-Autostart-enabled=true
DESKTOP
  echo "autostart on: $AUTOSTART_FILE"
  local name cfg line var
  while IFS='|' read -r name cfg line var; do
    if [ -n "$cfg" ]; then
      wm_add "$name" "$cfg" "$line"
    elif [ -n "${!var:-}" ]; then
      echo "$name doesn't read ~/.config/autostart -- add this line to your $name config: $line"
    fi
  done < <(wm_rows)
}

autostart_off() {
  mkdir -p "$STATE_DIR"; echo off > "$AUTOSTART_STATE"
  rm -f "$AUTOSTART_FILE"
  local name cfg line var
  while IFS='|' read -r name cfg line var; do
    [ -n "$cfg" ] && wm_remove "$cfg"
  done < <(wm_rows)
  echo "autostart off"
}

autostart_status() {
  if [ -f "$AUTOSTART_FILE" ]; then echo "autostart entry : on  ($AUTOSTART_FILE)"; else echo "autostart entry : off"; fi
  local name cfg line var pid
  while IFS='|' read -r name cfg line var; do
    [ -n "$cfg" ] || continue
    if has_block "$cfg"; then printf '%-15s : on  (%s)\n' "$name config" "$cfg"; else printf '%-15s : off (%s)\n' "$name config" "$cfg"; fi
  done < <(wm_rows)
  if pid="$(app_pid)"; then echo "running         : yes (pid $pid)"; else echo "running         : no"; fi
}

autostart() {
  case "${1:-status}" in
    on)     autostart_on ;;
    off)    autostart_off ;;
    status) autostart_status ;;
    *)      echo "usage: mystiquectl autostart [on|off|status]" >&2; return 2 ;;
  esac
}

uninstall() {
  local yes="" managed="" pid="" what=()
  [ "${1:-}" = "-y" ] && yes=1
  # Only the checkout install.sh's curl | bash path cloned is ours to delete.
  local default_dir="${MYSTIQUECTL_DIR:-$DATA_DIR/mystiquectl}"
  [ -d "$default_dir" ] && [ "$(cd "$default_dir" && pwd)" = "$HERE" ] && managed=1

  pid="$(app_pid)" && what+=("running app   stop it (pid $pid)")
  # The launcher may belong to a different checkout; leave that one alone.
  grep -qF "$HERE/" "$LAUNCHER" 2>/dev/null && what+=("launcher      $LAUNCHER")
  [ -e "$DESKTOP_FILE" ]   && what+=("menu entry    $DESKTOP_FILE")
  [ -e "$ICON_FILE" ]      && what+=("icon          $ICON_FILE")
  [ -e "$AUTOSTART_FILE" ] && what+=("autostart     $AUTOSTART_FILE")
  local name cfg line var
  while IFS='|' read -r name cfg line var; do
    has_block "$cfg" && what+=("autostart     the mystiquectl lines in $cfg")
  done < <(wm_rows)
  grep -qa DC_CAPTURE_DIR "$ASAR" 2>/dev/null && what+=("shim          restore the original $ASAR")
  [ -n "$managed" ] && what+=("checkout      $HERE (with its electron)")

  if [ "${#what[@]}" = 0 ]; then echo "nothing to uninstall"; return 0; fi
  echo "this will remove:"; printf '  %s\n' "${what[@]}"
  [ -z "$managed" ] && echo "and keep $HERE (not created by install.sh)"
  if [ -z "$yes" ]; then
    if ! { : </dev/tty; } 2>/dev/null; then
      echo "error: no terminal to confirm on -- re-run as: mystiquectl uninstall -y" >&2; return 1
    fi
    local ans; read -r -p "go ahead? [y/N] " ans </dev/tty
    case "$ans" in y|Y|yes) ;; *) echo "cancelled"; return 1 ;; esac
  fi

  # First, so it isn't still holding app.asar and the bridge while they go.
  # run-real.sh's EXIT trap takes the bridge down with it.
  if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null
    for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    if kill -0 "$pid" 2>/dev/null; then
      echo "warning: the app (pid $pid) ignored SIGTERM for 5s -- killing it" >&2
      kill -KILL "$pid" 2>/dev/null
    fi
  fi
  autostart_off >/dev/null
  # Only our own file: the directory also holds claude-usage.sh's override,
  # which is yours.
  rm -f "$AUTOSTART_STATE"; rmdir "$STATE_DIR" 2>/dev/null
  if grep -qa DC_CAPTURE_DIR "$ASAR" 2>/dev/null; then
    DC_ASAR="$ASAR" "$HERE/shim.py" uninstall || echo "warning: could not restore app.asar -- see above; continuing" >&2
  fi
  grep -qF "$HERE/" "$LAUNCHER" 2>/dev/null && rm -f "$LAUNCHER"
  rm -f "$DESKTOP_FILE" "$ICON_FILE"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$DATA_DIR/applications" >/dev/null 2>&1
  # Last: this script is running from inside it.
  [ -n "$managed" ] && rm -rf "$HERE"
  echo "uninstalled."
}

case "${1:-}" in
  --background)    shift; background "$@" ;;
  autostart)       shift; autostart "$@" ;;
  update)          shift; exec "$HERE/install.sh" update "$@" ;;
  uninstall)       shift; uninstall "$@" ;;
  help|-h|--help)  usage ;;
  *)               run "$@" ;;
esac
